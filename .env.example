# Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
VITE_API_URL=http://localhost:3000/api

# App Configuration
VITE_APP_NAME=Disaster Preparedness Platform
VITE_APP_VERSION=4.0.0

# Feature Flags
VITE_ENABLE_VR_TRAINING=true
VITE_ENABLE_COMMUNITY=true
VITE_ENABLE_SMS_IVR=true

# Logging
VITE_LOG_LEVEL=info

# Authentication
# VITE_AUTH_TOKEN_EXPIRY=3600

# Third-party Services (if needed)
# VITE_SENTRY_DSN=
# VITE_ANALYTICS_ID=
